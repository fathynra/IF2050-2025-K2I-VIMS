<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextField?> <?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.vims.ui.controllers.BuyProductController"
      spacing="15.0" style="-fx-padding: 20;">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label text="Beli Produk Investasi" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="10">
        <Label text="Nama Produk:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <Label fx:id="productNameLabel" text="[Nama Produk]" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Harga per Unit:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <Label fx:id="productPriceLabel" text="[Harga Produk]" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Sisa Saldo Anda:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-style: italic;"/>
        <Label fx:id="investorBalanceLabel" text="[Saldo Investor]" GridPane.rowIndex="2" GridPane.columnIndex="1" style="-fx-font-style: italic;"/>

        <Label text="Jumlah Unit Beli:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <Spinner fx:id="unitsToPurchaseSpinner" min="1" max="10000" initialValue="1" editable="true" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="Metode Pembayaran:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <ComboBox fx:id="paymentMethodComboBox" promptText="Pilih Metode" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

        <Label text="Total Pembelian:" GridPane.rowIndex="5" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
        <Label fx:id="totalCostLabel" text="Rp 0,00" GridPane.rowIndex="5" GridPane.columnIndex="1" style="-fx-font-weight: bold;"/>
    </GridPane>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Batal" onAction="#handleCancelAction"/>
        <Button fx:id="reviewOrderButton" text="Review Pesanan" onAction="#handleReviewOrderAction" style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
    </HBox>
</VBox>