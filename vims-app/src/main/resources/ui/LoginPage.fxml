<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.vims.ui.controllers.LoginPageController" 
      alignment="CENTER" spacing="20.0" style="-fx-padding: 40;">

    <Label text="VIMS" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #4A90E2;">
        <font>
            <Font name="Arial Bold" size="36.0"/>
        </font>
    </Label>
    <Label text="VUNGUARD INVESTMENT MANAGEMENT SYSTEM" style="-fx-font-size: 14px; -fx-text-fill: gray;"/>

    <VBox spacing="10" maxWidth="300">
        <Label text="Welcome Back" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

        <Label text="Email"/>
        <TextField fx:id="emailField" promptText="Enter your email"/>

        <Label text="Password" style="-fx-padding: 10 0 0 0;"/>
        <PasswordField fx:id="passwordField" promptText="Enter your password"/>

        <Label fx:id="errorLabel" style="-fx-text-fill: red; -fx-padding: 5 0 0 0;"/> 
        <Button fx:id="loginButton" text="Login" onAction="#handleLoginAction" 
                defaultButton="true" prefWidth="Infinity"
                style="-fx-background-color: #4A90E2; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10;"/>
    </VBox>
</VBox>