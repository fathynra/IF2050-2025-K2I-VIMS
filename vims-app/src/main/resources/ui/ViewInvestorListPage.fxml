<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Button?> <?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.vims.ui.controllers.ViewInvestorListPageController"
      spacing="10.0" style="-fx-padding: 20;">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label text="Manajemen Daftar Investor" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <TableView fx:id="investorTableView" prefHeight="400.0" prefWidth="750.0">
        <columns>
            <TableColumn fx:id="accountIdColumn" prefWidth="75.0" text="ID Akun"/>
            <TableColumn fx:id="nameColumn" prefWidth="150.0" text="Nama"/>
            <TableColumn fx:id="emailColumn" prefWidth="200.0" text="Email"/>
            <TableColumn fx:id="roleColumn" prefWidth="100.0" text="Peran"/>
            <TableColumn fx:id="statusColumn" prefWidth="100.0" text="Status"/>
            <TableColumn fx:id="actionColumn" prefWidth="120.0" text="Aksi"/> 
        </columns>
    </TableView>
    <HBox spacing="10" alignment="CENTER_RIGHT" style="-fx-padding: 10 0 0 0;">
        <Button text="Refresh Data" onAction="#handleRefreshAction"/>
    </HBox>
</VBox>