<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.vims.ui.controllers.AddProductController"
      spacing="15.0" style="-fx-padding: 20;">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label text="Tambah Produk Investasi Baru" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="10">
        <Label text="Nama Produk:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="productNameField" promptText="Contoh: Saham ABC" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="300.0"/>

        <Label text="Tipe Produk:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <ComboBox fx:id="productTypeComboBox" promptText="Pilih Tipe" GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="300.0"/>

        <Label text="Level Risiko:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="riskLevelField" promptText="Contoh: Rendah, Sedang, Tinggi" GridPane.rowIndex="2" GridPane.columnIndex="1" prefWidth="300.0"/>

        <Label text="Harga per Unit:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="unitPriceField" promptText="Contoh: 1500.75" GridPane.rowIndex="3" GridPane.columnIndex="1" prefWidth="300.0"/>

        <Label text="Deskripsi Produk:" GridPane.rowIndex="4" GridPane.columnIndex="0" VBox.vgrow="ALWAYS"/>
        <TextArea fx:id="descriptionArea" promptText="Deskripsi singkat produk, tujuan investasi, atau fokus sektor..." 
                  GridPane.rowIndex="5" GridPane.columnIndex="1" prefHeight="100.0" wrapText="true"/>
    </GridPane>

    <Label fx:id="errorLabel" style="-fx-text-fill: red; -fx-padding: 5 0 0 0;"/>

    <HBox spacing="10" alignment="CENTER_RIGHT" style="-fx-padding: 10 0 0 0;">
        <Button text="Batal" onAction="#handleCancelAction"/>
        <Button fx:id="addProductButton" text="Tambah Produk" onAction="#handleAddProductAction" 
                style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-font-weight: bold;"/>
    </HBox>
</VBox>