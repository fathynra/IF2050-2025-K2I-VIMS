<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.vims.ui.controllers.ProductRequestHistoryController"
      spacing="15.0" style="-fx-padding: 20;">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label fx:id="pageTitleLabel" text="Riwayat Permintaan Produk Anda" style="-fx-font-size: 18px; -fx-font-weight: bold;" HBox.hgrow="ALWAYS"/>
        <Button fx:id="addNewRequestButton" text="+ Buat Permintaan Baru" onAction="#handleAddNewRequestButton" style="-fx-background-color: #007bff; -fx-text-fill: white;"/>
    </HBox>
    
    <TableView fx:id="requestHistoryTableView" prefHeight="400.0">
        <columns>
            <TableColumn fx:id="requestIdColumn" prefWidth="120.0" text="ID Permintaan"/>
            <TableColumn fx:id="investorIdColumn" prefWidth="100.0" text="ID Investor"/> <TableColumn fx:id="productNameColumn" prefWidth="200.0" text="Nama Produk Diminta"/>
            <TableColumn fx:id="productTypeColumn" prefWidth="150.0" text="Tipe Produk"/>
            <TableColumn fx:id="statusColumn" prefWidth="120.0" text="Status"/>
            <TableColumn fx:id="actionColumn" prefWidth="150.0" text="Aksi (Manajer)"/> </columns>
    </TableView>
    
    <Label fx:id="infoLabel" text="" style="-fx-padding: 10 0 0 0;"/>
</VBox>