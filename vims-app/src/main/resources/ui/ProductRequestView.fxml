<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.vims.ui.controllers.ProductRequestViewController"
      spacing="15.0" style="-fx-padding: 20;">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label text="Form Permintaan Penambahan Produk Investasi" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="10">
        <Label text="Nama Produk Diminta:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="productNameField" promptText="Contoh: Saham Perusahaan X, Obligasi Y" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="300.0"/>

        <Label text="Tipe Produk:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <ComboBox fx:id="productTypeComboBox" promptText="Pilih Tipe Produk" GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="300.0"/>

        <Label text="Alasan Permintaan:" GridPane.rowIndex="2" GridPane.columnIndex="0" VBox.vgrow="ALWAYS"/>
        <TextArea fx:id="reasonArea" promptText="Jelaskan mengapa Anda menginginkan produk ini..." 
                  GridPane.rowIndex="2" GridPane.columnIndex="1" prefHeight="80.0" wrapText="true"/>
    </GridPane>

    <Label fx:id="errorLabel" style="-fx-text-fill: red; -fx-padding: 5 0 0 0;"/>

    <HBox spacing="10" alignment="CENTER_RIGHT" style="-fx-padding: 10 0 0 0;">
        <Button text="Batal" onAction="#handleCancelAction"/>
        <Button fx:id="submitRequestButton" text="Kirim Permintaan" onAction="#handleSubmitRequestAction" 
                style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-font-weight: bold;"/>
    </HBox>
</VBox>