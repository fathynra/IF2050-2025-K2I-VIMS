<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.TextFlow?>
<?import javafx.scene.text.Text?>


<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.vims.ui.controllers.ProductDetailController"
      spacing="15.0" style="-fx-padding: 20;">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Button fx:id="backButton" text="&lt; Kembali" onAction="#handleBackAction" style="-fx-font-size: 14px;"/>
        <Label fx:id="productNameHeaderLabel" text="[Nama Produk]" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
    </HBox>

    <Label fx:id="productTypeDetailLabel" text="[Tipe/Deskripsi Singkat Produk]" style="-fx-font-size: 14px; -fx-text-fill: gray; -fx-padding: 0 0 10 0;"/>

    <GridPane hgap="10" vgap="8" style="-fx-padding: 10 0 10 0;">
        <Label text="Level Risiko:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
        <Label fx:id="riskLevelLabel" text="[Level Risiko]" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Harga Saat Ini:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
        <Label fx:id="priceLabel" text="[Harga]" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
    </GridPane>

    <Label text="Tujuan / Deskripsi Produk:" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 10 0 5 0;"/>
    <ScrollPane fitToWidth="true" prefHeight="150.0">
         <TextArea fx:id="descriptionArea" editable="false" wrapText="true" style="-fx-focus-color: transparent; -fx-faint-focus-color: transparent; -fx-background-insets: 0; -fx-background-color: transparent;"/>
    </ScrollPane>

    </VBox>