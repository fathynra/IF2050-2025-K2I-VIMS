<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox fx:id="productCard" alignment="CENTER_LEFT" spacing="8.0"
      style="-fx-padding: 15; -fx-border-color: lightgray; -fx-border-width: 1; -fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0.5, 2, 2);"
      prefWidth="250.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.vims.ui.controllers.ProductCardController"> <children>
        <Label fx:id="productNameLabel" text="NAMA PRODUK (ADRO)" style="-fx-font-weight: bold; -fx-font-size: 16px;"/>
        <Label fx:id="productDescriptionLabel" text="Deskripsi Singkat Produk (PT)" style="-fx-font-size: 12px; -fx-text-fill: gray;"/>

        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="Harga:" style="-fx-font-weight: bold;"/>
            <Label fx:id="priceLabel" text="Rp 0.00"/>
        </HBox>

        <Label fx:id="changeLabel" text="+0.00 (+0.00%)" style="-fx-text-fill: green;"/> 
        <HBox spacing="10.0" alignment="CENTER_RIGHT" VBox.vgrow="ALWAYS">
            <Button fx:id="seeDetailsButton" text="See Details ->" onAction="#handleSeeDetails" styleClass="link-button"/>
            <VBox HBox.hgrow="ALWAYS"/> <Button fx:id="sellButton" text="Sell" onAction="#handleSellAction" style="-fx-background-color: #FFD1D1; -fx-text-fill: #D8000C;"/>
            <Button fx:id="buyButton" text="Buy" onAction="#handleBuyAction" style="-fx-background-color: #DFF2BF; -fx-text-fill: #4F8A10;"/>
        </HBox>
    </children>
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
    </padding>
</VBox>